# AutoOps Configuration Environment Variables

# Database Connection (SQLite default for local development)
DATABASE_URL="sqlite:///./autoops.db"

# Prometheus Monitoring Endpoint
PROMETHEUS_URL="http://localhost:9090"

# Demonstration Simulation Mode (set to true for simulation data)
SIMULATION_MODE="true"

# Optional External Webhook Endpoint (Slack/PagerDuty/Custom Webhook)
WEBHOOK_URL="https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX"

# Node / FastAPI Server Ports
PORT=3000
FASTAPI_PORT=8000
NODE_ENV="development"
